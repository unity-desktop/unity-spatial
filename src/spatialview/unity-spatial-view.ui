<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="UnitySpatialView" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout"/>
    </property>
    <child>
      <object class="AdwToolbarView" id="toolbar">
        <child type="top">
          <object class="GtkSearchBar" id="search_bar">
            <property name="opacity">0</property>
            <property name="search-mode-enabled">True</property>
            <property name="visible" bind-source="UnitySpatialView" bind-property="enable-search" bind-flags="sync-create"/>
            <property name="child">
              <object class="AdwClamp">
                <property name="maximum-size">600</property>
                <property name="child">
                  <object class="GtkSearchEntry" id="search">
                    <property name="hexpand">True</property>
                    <property name="margin-top">9</property>
                    <property name="placeholder-text" translatable="yes">Search</property>
                    <signal name="search-changed" handler="search_changed_cb" swapped="true"/>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <property name="content">
          <object class="AdwViewStack" id="pages">
            <signal name="notify::visible-child-name" handler="update_bar_style" swapped="true"/>
            <child>
              <object class="AdwViewStackPage">
                <property name="name">carousel</property>
                <property name="child">
                  <object class="UnitySpatialCarousel" id="carousel">
                    <property name="progress" bind-source="UnitySpatialView" bind-property="progress" bind-flags="sync-create"/>
                    <signal name="notify::scrolled" handler="update_bar_style" swapped="true"/>
                    <signal name="page-changed" handler="carousel_page_changed_cb" swapped="true"/>
                    <child>
                      <object class="GtkGestureClick">
                        <signal name="released" handler="released_cb" swapped="true"/>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwViewStackPage">
                <property name="name">search</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="visible" bind-source="UnitySpatialView" bind-property="enable-search" bind-flags="sync-create"/>
                    <property name="icon-name">edit-find-symbolic</property>
                    <property name="title" translatable="yes">No Search Results</property>
                    <property name="description" translatable="yes">Try a different search term</property>
                    <signal name="notify::visible" handler="search_changed_cb" swapped="true"/>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkShortcutController">
        <property name="scope">global</property>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">Escape</property>
            <property name="action">action(spatialview.close)</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
